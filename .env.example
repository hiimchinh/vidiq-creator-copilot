# Only needed for Live mode. Replay mode (the default) needs no keys at all.
# Visitors bring their own vidIQ key in the browser; the server never stores it.

# Server-side LLM for planning and answers (OpenRouter).
OPENROUTER_API_KEY=
# Any OpenRouter model with tool calling. Default: google/gemini-3.1-flash-lite
OPENROUTER_MODEL=
# Hard daily cap on LLM spend for this server process, in USD (resets at midnight Asia/Ho_Chi_Minh).
LLM_SPEND_CAP_USD=0.5
